# 더벨 News Clipper 설정
# 이 파일 없이 실행해도 됩니다 — 첫 실행 시 브라우저 설정 화면에서 입력할 수 있습니다.

# Claude API (필수)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# 더벨 로그인 (선택 — 비우면 브라우저에서 직접 로그인)
THEBELL_ID=
THEBELL_PW=

# 앱 설정
LOG_LEVEL=INFO
PORT=8000

# 브라우저 설정
BROWSER_HEADLESS=true
CRAWL_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=30000
MAX_CONCURRENT_PAGES=3

# 정리
CLEANUP_HOURS=24
